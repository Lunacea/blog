{
  "workspace": [
    "./apps/*",
    "./packages/*"
  ],
  "nodeModulesDir": "auto",
  "imports": {
    "@lunacea/api": "./packages/api/mod.ts",
    "@lunacea/config": "./packages/config/mod.ts",
    "@lunacea/content": "./packages/content/mod.ts",
    "@lunacea/core/": "./packages/core/",
    "@lunacea/schemas": "./packages/schemas/mod.ts",
    "@lunacea/ui/": "./packages/ui/src/",
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "@std/yaml": "jsr:@std/yaml@^1.1.1",
    "hono": "npm:hono@4.12.27",
    "hono/": "npm:hono@4.12.27/",
    "svelte": "npm:svelte@5.56.4",
    "zod": "npm:zod@4.4.3"
  },
  "tasks": {
    "dev": "deno task --cwd apps/web dev",
    "build": "deno task content:generate && deno task content:validate && deno task --cwd apps/web build",
    "fonts:generate": "deno run -A packages/ui/scripts/generate-fonts.ts",
    "fonts:check": "deno run -A packages/ui/scripts/check-fonts.ts",
    "images:generate": "deno run -A apps/web/scripts/generate-images.ts",
    "links:refresh": "deno run -A apps/web/scripts/refresh-link-previews.ts",
    "content:generate": "deno run --allow-read --allow-write packages/content/generate.ts",
    "budget:check": "deno run --allow-read apps/web/scripts/check-budget.ts",
    "design:check": "deno run --allow-read scripts/check-design-system.ts",
    "preview": "deno task --cwd apps/web preview",
    "preview:audit": "deno task --cwd apps/web preview:audit",
    "check": "deno task fonts:generate && deno task images:generate && deno task content:generate && deno task content:validate && deno task --cwd apps/web check",
    "content:validate": "deno run --allow-read packages/content/validate.ts",
    "test": "deno test --allow-env --allow-read --unstable-kv packages/core packages/schemas packages/api packages/ui/src/visuals/hero-geometry.test.ts packages/ui/src/visuals/weather-visual.test.ts && deno task test:unit",
    "test:unit": "deno task --cwd apps/web test:unit",
    "test:e2e": "deno task --cwd apps/web test:e2e",
    "storybook": "deno task --cwd packages/ui storybook",
    "storybook:check": "deno task --cwd packages/ui test:storybook",
    "lint": "deno lint apps packages e2e",
    "fmt": "deno fmt apps packages e2e docs README.md deno.json",
    "fmt:check": "deno fmt --check apps packages e2e docs README.md deno.json"
  },
  "fmt": {
    "useTabs": false,
    "lineWidth": 100,
    "indentWidth": 2,
    "singleQuote": false,
    "exclude": [
      "**/node_modules/**",
      "**/.svelte-kit/**",
      "**/build/**",
      "**/storybook-static/**",
      "**/*.timestamp-*.mjs",
      "**/*.svelte"
    ]
  },
  "lint": {
    "rules": {
      "tags": [
        "recommended"
      ]
    },
    "exclude": [
      "**/node_modules/**",
      "**/.svelte-kit/**",
      "**/build/**",
      "**/*.timestamp-*.mjs",
      "**/*.svelte"
    ]
  }
}
