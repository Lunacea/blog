{
  "extends": "../../apps/web/.svelte-kit/tsconfig.json",
  "compilerOptions": {
    "allowJs": true,
    "allowImportingTsExtensions": true,
    "baseUrl": "../..",
    "checkJs": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "types": [
      "vite/client"
    ],
    "paths": {
      "$app/navigation": [
        "packages/ui/.storybook/mocks/app-navigation.ts"
      ],
      "@lunacea/config": [
        "packages/config/mod.ts"
      ],
      "@lunacea/schemas": [
        "packages/schemas/mod.ts"
      ]
    },
    "verbatimModuleSyntax": true
  },
  "include": [
    "src/**/*.d.ts",
    "src/**/*.svelte"
  ]
}
