{
  "imports": {
    "@/": "./src/",
    "~/": "../packages/",
    "vite": "npm:vite@^8.0.16",
    "svelte": "npm:svelte@^5.56.3",
    "@sveltejs/vite-plugin-svelte": "npm:@sveltejs/vite-plugin-svelte@^7.1.2",
    "tailwindcss": "npm:tailwindcss@^4.3.1",
    "@tailwindcss/vite": "npm:@tailwindcss/vite@^4.3.1",
    "vitest": "npm:vitest@^4.1.7",
    "jsdom": "npm:jsdom@^29.1.1",
    "@testing-library/svelte": "npm:@testing-library/svelte@^5.3.1",
    "@playwright/test": "npm:@playwright/test@^1.61.0",
    "storybook": "npm:storybook@^10.4.6",
    "@storybook/svelte-vite": "npm:@storybook/svelte-vite@^10.4.6",
    "@storybook/addon-a11y": "npm:@storybook/addon-a11y@^10.4.6",
    "typescript": "npm:typescript@^6.0.3"
  },
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "deno.ns"]
  },
  "tasks": {
    "dev": "deno run -A npm:vite",
    "build": "deno run -A npm:vite build",
    "preview": "deno run -A npm:vite preview",
    "test:unit": "deno run -A npm:vitest --ui",
    "test:e2e": "deno run -A npm:@playwright/test test --ui",
    "storybook": "deno run -A npm:storybook dev",
    "build-storybook": "deno run -A npm:storybook build"
  }
}
