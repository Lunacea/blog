        <ul class="m-0! list-none! divide-y divide-rule p-0! @min-[30rem]:border-r @min-[30rem]:border-rule" aria-label="受信一覧">
          <li class="m-0! grid grid-cols-[minmax(0,1fr)_auto] items-center gap-x-3 px-4 py-3 @min-[30rem]:bg-canvas"><span class="grid gap-1"><span class="text-caption leading-none text-quiet">編集部</span><span class="truncate text-small font-emphasis">来月号の入稿日について</span></span><span class="text-quiet @min-[30rem]:hidden" aria-hidden="true">›</span></li>
          <li class="m-0! grid grid-cols-[minmax(0,1fr)_auto] items-center gap-x-3 px-4 py-3"><span class="grid gap-1"><span class="text-caption leading-none text-quiet">デザイン部</span><span class="truncate text-small">表紙案を2つ送ります</span></span><span class="text-quiet @min-[30rem]:hidden" aria-hidden="true">›</span></li>
          <li class="m-0! grid grid-cols-[minmax(0,1fr)_auto] items-center gap-x-3 px-4 py-3"><span class="grid gap-1"><span class="text-caption leading-none text-quiet">印刷所</span><span class="truncate text-small">色校正の日程</span></span><span class="text-quiet @min-[30rem]:hidden" aria-hidden="true">›</span></li>
        </ul>
