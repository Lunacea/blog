#!/bin/sh
echo "=== Running Quality Checks (Formatter & Linter) ==="

# 1. ステージングされたファイルの一覧を取得
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACMR)

if [ -z "$STAGED_FILES" ]; then
  exit 0
fi

# Deno 2.x が自動フォーマット可能な拡張子をフィルタリング
FMT_FILES=$(echo "$STAGED_FILES" | grep -E '\.(js|ts|jsx|tsx|svelte|json|css|html|md)$')

# 2. 自動フォーマットを実行
if [ -n "$FMT_FILES" ]; then
  echo "🧹 [Pre-commit] Formatting staged files..."
  echo "$FMT_FILES" | xargs deno fmt
  # 整形後のファイルを自動的に再ステージング
  echo "$FMT_FILES" | xargs git add
fi

# 3. 静的解析（リント）を実行
LINT_FILES=$(echo "$STAGED_FILES" | grep -E '\.(js|ts|jsx|tsx|svelte)$')

if [ -n "$LINT_FILES" ]; then
  echo "🔍 [Pre-commit] Linting staged files..."
  echo "$LINT_FILES" | xargs deno lint
  if [ $? -ne 0 ]; then
    echo "❌ [Pre-commit] Lint failed. Fix warnings before committing."
    exit 1
  fi
else
  echo "🍃 [Pre-commit] No code files (JS/TS/Svelte) to lint. Skipping step."
fi

echo "✅ [Pre-commit] Perfect! Proceeding to commit."
exit 0
