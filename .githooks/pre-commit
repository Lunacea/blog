#!/bin/sh
# ステージした内容だけを整形・検査する。作業ツリーの未ステージの変更は取り込まない。
set -eu

root=$(git rev-parse --show-toplevel)
staged=$(git diff --cached --name-only --diff-filter=ACMR)
[ -n "$staged" ] || exit 0

fmt_files=$(printf '%s\n' "$staged" | grep -E '\.(js|ts|jsx|tsx|svelte|json|jsonc|css|html|md|yml|yaml)$' || true)
# deno lint は Svelte を読めない。型と Svelte の検査は `deno task check` が受け持つ。
lint_files=$(printf '%s\n' "$staged" | grep -E '\.(js|ts|jsx|tsx)$' || true)
[ -n "$fmt_files$lint_files" ] || exit 0

snapshot=$(mktemp -d)
trap 'rm -rf "$snapshot"' EXIT

# ステージされた版を一時ディレクトリへ書き出し、検査はそちらに対して行う。
for file in $fmt_files $lint_files; do
  mkdir -p "$snapshot/$(dirname "$file")"
  git show ":$file" > "$snapshot/$file"
done

failed=0

if [ -n "$fmt_files" ]; then
  echo "pre-commit: 整形を確認しています"
  unformatted=""
  for file in $fmt_files; do
    if ! deno fmt --quiet --config "$root/deno.json" --check "$snapshot/$file" >/dev/null 2>&1; then
      if git diff --quiet -- "$file"; then
        # 未ステージの変更がなければ、整形して同じ内容を再ステージしても安全。
        deno fmt --quiet --config "$root/deno.json" "$root/$file"
        git add -- "$file"
        echo "  整形して再ステージ: $file"
      else
        unformatted="$unformatted $file"
      fi
    fi
  done
  if [ -n "$unformatted" ]; then
    echo "pre-commit: 未ステージの変更があるため自動整形できません。整形してからステージしてください:"
    for file in $unformatted; do echo "  deno fmt $file"; done
    failed=1
  fi
fi

if [ -n "$lint_files" ]; then
  echo "pre-commit: lint を確認しています"
  targets=""
  for file in $lint_files; do targets="$targets $snapshot/$file"; done
  # shellcheck disable=SC2086
  if ! deno lint --quiet --config "$root/deno.json" $targets; then
    failed=1
  fi
fi

exit "$failed"
